# Normalización de fin de línea
# text=auto: git decide según el contenido (texto → normaliza, binario → no toca)
* text=auto

# Fuentes de texto: siempre LF
*.java text eol=lf
*.fxml text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.mf text eol=lf
*.txt text eol=lf
*.sql text eol=lf

# Binarios: nunca normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.class binary
