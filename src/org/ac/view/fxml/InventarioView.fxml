<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ac.controller.InventarioController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolver" text="Volver al Menú" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Inventario" />
            <Label wrapText="true" text="Consulta de existencias disponibles de cada libro." />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Stock de Libros" />
            <TextField fx:id="txtBuscar" promptText="Buscar por ISBN, título, precio o stock…" />
            <TableView fx:id="tablaInventario">
                <columns>
                    <TableColumn fx:id="colIsbn" prefWidth="150" text="ISBN" />
                    <TableColumn fx:id="colTitulo" prefWidth="220" text="Título" />
                    <TableColumn fx:id="colPrecio" prefWidth="100" text="Precio" />
                    <TableColumn fx:id="colStock" prefWidth="100" text="Stock" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
