<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ac.controller.ClienteController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
             <Button onAction="#handleVolver" text="Volver al Menú" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Cliente" />
            <TextField fx:id="txtCui" disable="true" prefHeight="30.0" promptText="CUI" />
            <TextField fx:id="txtNombre" disable="true" prefHeight="30.0" promptText="Nombre" />
            <TextField fx:id="txtApellido" disable="true" prefHeight="30.0" promptText="Apellido" />
            <TextField fx:id="txtCorreo" disable="true" prefHeight="30.0" promptText="Correo Electrónico" />
            <HBox spacing="10">
                <Button fx:id="btnNuevo" onAction="#handleNuevoCliente" prefWidth="120" text="Nuevo Cliente" />
                <Button fx:id="btnEditar" onAction="#handleEditar" prefWidth="120" text="Editar" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleCancelar" prefWidth="120" text="Cancelar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Clientes" />
            <TextField fx:id="txtBuscar" promptText="Buscar por CUI, nombre o apellido…" />
            <TableView fx:id="tablaClientes">
                <columns>
                    <TableColumn fx:id="colCUI" prefWidth="120" text="CUI" />                                            
                    <TableColumn fx:id="colNombreCliente" prefWidth="140" text="Nombre Cliente" />                                            
                    <TableColumn fx:id="colApellidoCliente" prefWidth="140" text="Apellido Cliente" />                                            
                    <TableColumn fx:id="colCorreoElectronico" prefWidth="200" text="Correo Electrónico" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnPrimero" onAction="#handlePrimero" text="Primero" />
                <Button fx:id="btnAnterior" onAction="#handleAnterior" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" text="Siguiente" />
                <Button fx:id="btnUltimo" onAction="#handleUltimo" text="Último" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
