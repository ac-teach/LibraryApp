<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ac.controller.InicioSesionController">
    <stylesheets>
        <URL value="@/org/ac/view/style/base.css" />
    </stylesheets>
   <children>
      <StackPane layoutX="100.0" layoutY="100.0" prefHeight="200.0" prefWidth="400.0">
         <children>
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="25.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="133.0" minWidth="10.0" prefWidth="108.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="210.0" minWidth="10.0" prefWidth="192.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="25.0" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
                <children>
                  <Label text="USUARIO:" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <font>
                        <Font size="14.0" />
                     </font></Label>
                  <Label text="CONTRASEÑA:" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <font>
                        <Font size="14.0" />
                     </font></Label>
                  <TextField fx:id="txtUsuario" prefHeight="30.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                     <font>
                        <Font size="14.0" />
                     </font></TextField>
                  <PasswordField fx:id="txtPassword" prefHeight="30.0" GridPane.columnIndex="2" GridPane.rowIndex="2">
                     <font>
                        <Font size="14.0" />
                     </font></PasswordField>
                  <Button fx:id="btnIniciarSesion" mnemonicParsing="false" onAction="#eventoInicioSesion" prefHeight="30.0" prefWidth="203.0" text="INICIAR" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                  <Button fx:id="btnRegistrarse" mnemonicParsing="false" onAction="#eventoRegistrarse" prefHeight="30.0" prefWidth="100.0" text="Registrarse" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </children>
            </GridPane>
         </children>
      </StackPane>
      <Label layoutX="204.0" layoutY="38.0" text="INICIO DE SESIÓN">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label fx:id="lblMensaje" layoutX="271.0" layoutY="309.0" text="" textFill="#f83737" />
