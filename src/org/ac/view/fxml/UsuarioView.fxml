<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ac.controller.UsuarioController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolver" text="Volver al Menú" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Usuario" />
            <TextField fx:id="txtUsername" disable="true" prefHeight="30.0" promptText="Username" />
            <TextField fx:id="txtEmail" disable="true" prefHeight="30.0" promptText="Correo electrónico" />
            <TextField fx:id="txtNombre" disable="true" prefHeight="30.0" promptText="Nombre" />
            <TextField fx:id="txtApellido" disable="true" prefHeight="30.0" promptText="Apellido" />
            <ComboBox fx:id="cmbRol" disable="true" prefHeight="30.0" promptText="Rol" />
            <CheckBox fx:id="chkActivo" disable="true" text="Activo" />
            <PasswordField fx:id="txtPassword" disable="true" prefHeight="30.0" promptText="Contraseña (solo al crear)" />
            <HBox spacing="10">
                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefWidth="120" text="Nuevo" />
                <Button fx:id="btnEditar" onAction="#handleEditar" prefWidth="120" text="Editar" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleCancelar" prefWidth="120" text="Cancelar" />
            </HBox>
            <HBox spacing="10">
                <Button fx:id="btnCambiarPassword" onAction="#handleCambiarPassword" prefWidth="120" text="Cambiar Contraseña" />
            </HBox>
            <HBox spacing="10">
                <Button fx:id="btnDesactivar" onAction="#handleDesactivar" prefWidth="120" text="Desactivar" />
                <Button fx:id="btnEliminar" onAction="#handleEliminar" prefWidth="120" text="Eliminar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Usuarios" />
            <TextField fx:id="txtBuscar" promptText="Buscar por id, username, email o rol…" />
            <TableView fx:id="tablaUsuarios">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                    <TableColumn fx:id="colUsername" prefWidth="120" text="Username" />
                    <TableColumn fx:id="colEmail" prefWidth="180" text="Email" />
                    <TableColumn fx:id="colNombre" prefWidth="120" text="Nombre" />
                    <TableColumn fx:id="colApellido" prefWidth="120" text="Apellido" />
                    <TableColumn fx:id="colRol" prefWidth="100" text="Rol" />
                    <TableColumn fx:id="colActivo" prefWidth="70" text="Activo" />
                    <TableColumn fx:id="colFecha" prefWidth="140" text="Fecha Creación" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnPrimero" onAction="#handlePrimero" text="Primero" />
                <Button fx:id="btnAnterior" onAction="#handleAnterior" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" text="Siguiente" />
                <Button fx:id="btnUltimo" onAction="#handleUltimo" text="Último" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
