<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ac.controller.EditorialController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Button onAction="#handleVolver" text="Volver al Menú" />
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Editorial" />
            <TextField fx:id="txtNit" disable="true" prefHeight="30.0" promptText="NIT" />
            <TextField fx:id="txtNombre" disable="true" prefHeight="30.0" promptText="Nombre" />
            <TextField fx:id="txtTelefono" disable="true" prefHeight="30.0" promptText="Teléfono" />
            <TextField fx:id="txtDireccion" disable="true" prefHeight="30.0" promptText="Dirección" />
            <HBox spacing="10">
                <Button fx:id="btnNuevo" onAction="#handleNuevo" prefWidth="120" text="Nuevo" />
                <Button fx:id="btnEditar" onAction="#handleEditar" prefWidth="120" text="Editar" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleCancelar" prefWidth="120" text="Cancelar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Editoriales" />
            <TextField fx:id="txtBuscar" promptText="Buscar por NIT, nombre, teléfono o dirección…" />
            <TableView fx:id="tablaEditoriales">
                <columns>
                    <TableColumn fx:id="colNit" prefWidth="120" text="NIT" />
                    <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre" />
                    <TableColumn fx:id="colTelefono" prefWidth="140" text="Teléfono" />
                    <TableColumn fx:id="colDireccion" prefWidth="200" text="Dirección" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button fx:id="btnPrimero" onAction="#handlePrimero" text="Primero" />
                <Button fx:id="btnAnterior" onAction="#handleAnterior" text="Anterior" />
                <Button fx:id="btnSiguiente" onAction="#handleSiguiente" text="Siguiente" />
                <Button fx:id="btnUltimo" onAction="#handleUltimo" text="Último" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
